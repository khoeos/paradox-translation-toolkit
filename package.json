{
  "name": "paradox-translation-toolkit",
  "version": "3.1.0",
  "private": true,
  "description": "Help players and modders from many Paradox games to manage language and localisation files within mods",
  "license": "GPL-3.0-or-later",
  "author": "Khoeos",
  "homepage": "https://github.com/khoeos/paradox-translation-toolkit",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint && oxlint vitest.shared.ts",
    "test": "turbo run test",
    "e2e": "turbo run e2e",
    "typecheck": "turbo run typecheck && tsc --noEmit -p tsconfig.json",
    "postinstall": "node scripts/fix-bin-modes.mjs",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "clean": "turbo run clean && rimraf node_modules",
    "release:version": "changeset version && node scripts/prune-changelogs.mjs"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@types/node": "^26.6.2",
    "@vitest/ui": "5.0.1",
    "lefthook": "^2.1.14",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "rimraf": "^6.1.3",
    "turbo": "^2.11.2",
    "typescript": "catalog:"
  }
}
