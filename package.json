{
  "name": "paradox-translation-toolkit",
  "version": "3.0.0-beta.1",
  "private": true,
  "description": "Help players and modders from many Paradox games to manage language and localisation files within mods",
  "license": "CC-BY-NC-SA-4.0",
  "author": "Khoeos",
  "homepage": "https://github.com/khoeos/paradox-translation-toolkit",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint && oxlint vitest.shared.ts",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck && tsc --noEmit -p tsconfig.json",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "clean": "turbo run clean && rimraf node_modules"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.1",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@types/node": "^26.1.2",
    "@vitest/ui": "4.1.5",
    "lefthook": "^2.1.10",
    "oxfmt": "^0.61.0 ",
    "oxlint": "^1.76.0",
    "rimraf": "^6.1.3",
    "turbo": "^2.10.8",
    "typescript": "catalog:"
  }
}
