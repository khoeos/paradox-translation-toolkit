{
  "name": "@ptt/cli",
  "version": "0.2.0-beta.0",
  "private": true,
  "type": "module",
  "bin": {
    "ptt": "./bin/ptt.mjs"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "lint": "oxlint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rimraf dist .turbo coverage"
  },
  "dependencies": {
    "@ptt/converter": "workspace:*",
    "@ptt/fs-node": "workspace:*",
    "@ptt/games": "workspace:*",
    "@ptt/parser": "workspace:*",
    "@ptt/report": "workspace:*",
    "@ptt/shared": "workspace:*",
    "@ptt/translate": "workspace:*"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "catalog:",
    "esbuild": "catalog:",
    "rimraf": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
